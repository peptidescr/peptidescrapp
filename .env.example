# Which brand this site builds: upd (USA Peptide Depot, English only) or pcr
# (Peptides Costa Rica, Spanish + English). Unset = upd. See src/brand/brands.ts.
VITE_BRAND=upd

# Turns on the Shop and Rewards tabs and Home's store cards (points, Your usual,
# credit) on a site. Leave it unset or "false" until the store connection ships
# (Part B); set it per Netlify site, at build time. See src/brand/index.ts.
VITE_STORE_ENABLED=false

# Staging only: offers a TEST sign-in with a sample account (18 points, $60 referral credit,
# three referrals) so Home's points card, Rewards, Refer & earn and spending the balance at
# checkout can be tried before the stores' own sign-in exists. Build time. A live-site build
# (Netlify CONTEXT=production) always turns it off, whatever this says. Needs
# VITE_STORE_ENABLED=true. See src/lib/store/account.ts.
VITE_STORE_TEST_SIGNIN=false

# USA Peptide Depot only: sign in with the customer's own UPD account (UPD's Supabase
# project, with UPD's OK). The project address and its PUBLIC (anon) key, both given by
# UPD. Build time. The public key is made to ship inside apps, but still set it in the
# Netlify site's settings (or your local .env), never in a committed file. Unset = no
# real sign-in. Needs VITE_STORE_ENABLED=true. See src/lib/store/session.ts.
VITE_UPD_SUPABASE_URL=
VITE_UPD_SUPABASE_ANON_KEY=

# Web Push (closed-app reminders). Generate with: npx web-push generate-vapid-keys
# Set these in the Netlify site's environment, not in a committed file.

# Public key, needed at BUILD time so the app can subscribe.
VITE_VAPID_PUBLIC_KEY=
# Same public key, plus the private key and a contact, for the send function at RUNTIME.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Checkout (Part B). Runtime only, set in the Netlify site's environment by
# whoever holds the keys, scoped to branch deploys (staging), never Production.
# Never in a committed file. See netlify/lib/checkout.ts and netlify/lib/payments.ts.
# An order goes to the store's own order system; neither spec documents a test
# mode for orders, and UPD's says its emails and staff alerts fire at once.

# The only accepted value is "sandbox"; unset = checkout off.
STORE_CHECKOUT=
# Peptides CR: the SANDBOX partner key (pk_sandbox_...) and its signing secret.
# A live key is refused.
PCR_PARTNER_KEY=
PCR_SIGNING_SECRET=
# USA Peptide Depot: its order address is the same in testing as live, so every
# order reaches its staff. "true" only when test orders are expected.
UPD_LIVE_ORDERS_OK=
# USA Peptide Depot: the publishable key of its SANDBOX ChargX store, which starts
# the card payment (UPD API doc section 6). Without it a UPD card order has no link.
CHARGX_PUBLISHABLE_KEY=
# USA Peptide Depot: "store" starts card payments through UPD's own /api/checkout/card
# (as its developer asks) instead of the ChargX sandbox above. Whether that route charges
# REAL cards isn't known yet (asked): leave unset on staging until UPD says it's a sandbox.
UPD_CARD_PAYMENT=
# The secret of OUR webhook on the sandbox ChargX store (shown once when created),
# for https://<site>/api/chargx-webhook, event payment.succeeded.
CHARGX_WEBHOOK_SECRET=
