# Which brand this site builds: upd (USA Peptide Depot, English only) or pcr
# (Peptides Costa Rica, Spanish + English). Unset = upd. See src/brand/brands.ts.
VITE_BRAND=upd

# Turns on the Shop and Rewards tabs and Home's store cards (points, Your usual,
# credit) on a site. Leave it unset or "false" until the store connection ships
# (Part B); set it per Netlify site, at build time. See src/brand/index.ts.
VITE_STORE_ENABLED=false

# Web Push (closed-app reminders). Generate with: npx web-push generate-vapid-keys
# Set these in the Netlify site's environment, not in a committed file.

# Public key, needed at BUILD time so the app can subscribe.
VITE_VAPID_PUBLIC_KEY=
# Same public key, plus the private key and a contact, for the send function at RUNTIME.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Guest checkout (Part B, phase B1). Runtime only, set in the Netlify site's
# environment by whoever holds the keys, and only on the staging site. Never
# in a committed file. See netlify/lib/checkout.ts and netlify/lib/payments.ts.
# Every order is a real order in the store's system, which notifies its staff.

# The only accepted value is "sandbox"; unset = checkout off.
STORE_CHECKOUT=
# Peptides CR: the SANDBOX partner key (pk_sandbox_...) and its signing secret.
# A live key is refused.
PCR_PARTNER_KEY=
PCR_SIGNING_SECRET=
# USA Peptide Depot: its order API has no sandbox. "true" only once the store has
# agreed how test orders are handled.
UPD_LIVE_ORDERS_OK=
# The sandbox ChargX webhook's secret, sent by the store once the webhook exists.
CHARGX_WEBHOOK_SECRET=
